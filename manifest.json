{
  "manifest_version": 3,
  "name": "Clear Chats — AI 聊天批量删除",
  "version": "2.7.4",
  "description": "批量管理 AI 会话，并在 ChatGPT 中整理资料库文件和 AI 标题。",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clear Chats — AI 聊天批量删除",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://gemini.google.com/*",
        "https://www.kimi.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.deepseek.com/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://yuanbao.tencent.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": [
        "sites/shared.js",
        "sites/chatgpt.js",
        "sites/claude.js",
        "sites/grok.js",
        "sites/gemini.js",
        "sites/kimi.js",
        "sites/qwen.js",
        "sites/deepseek.js",
        "sites/chatglm.js",
        "sites/yuanbao.js",
        "sites/doubao.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
