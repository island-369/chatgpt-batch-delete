{
  "manifest_version": 3,
  "name": "ChatGPT 批量删除会话",
  "version": "1.3.0",
  "description": "在 ChatGPT 网页版批量勾选并删除多个会话：悬浮按钮 → 弹窗多选 → 一键删除，可收起弹窗后台继续。自动适配深浅色主题，纯本地运行，无任何权限申请。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
